{
  "name": "calisthenics-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node scripts/dev.mjs --api-only",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsc --noEmit && vite build",
    "build:api": "tsc -p server/tsconfig.json",
    "chat": "npm run build:api && node server/dist/main.js",
    "preview": "node scripts/dev.mjs --preview",
    "lint": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
