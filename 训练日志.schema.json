{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "街健训练日志",
  "description": "每个 session 为一天训练；exercises 记录动作，note 记录当天训练感受。",
  "type": "object",
  "required": ["sessions"],
  "additionalProperties": false,
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "exercises", "note"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "训练日期"
          },
          "exercises": {
            "type": "array",
            "minItems": 1,
            "description": "当天训练动作",
            "items": {
              "type": "object",
              "required": ["name", "sets"],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "动作名称，如 引体向上 / 高位引体 / 双杠臂屈伸"
                },
                "sets": {
                  "type": "array",
                  "minItems": 1,
                  "description": "按组顺序记录每组次数，组数由数组长度表示，如 [9, 9, 9, 6]",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          },
          "note": {
            "type": "string",
            "description": "训练感受与备注，可留空"
          }
        }
      }
    }
  }
}
